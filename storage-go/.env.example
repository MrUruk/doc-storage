# Copy to .env (container/default) or .env.development (local instance).
# InitEnv() picks the file by APP_ENV (fallback GO_ENV):
#   unset              -> .env
#   APP_ENV=development -> .env.development

HOST=localhost
PORT=8080
LOG_LEVEL=info

# Pandoc Connect service (DOCX -> HTML)
PANDOC_SERVICE_URL=http://localhost:9797

# Qdrant vector DB
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=qwen3_html_agentic_collection

# LLM for agentic chunking (OpenAI-compatible endpoint; used via eino)
MODEL_NAME=google/gemma-4-26B-A4B-it
MODEL_URL=http://localhost:9003
EMBEDDING_SERVICE_URL=http://localhost:9003/v1/embeddings
MAX_LENGTH=1000

# PostgreSQL (pgx)
DATABASE_URL=postgres://postgres:postgres@localhost:9999/agents?sslmode=disable

# S3-compatible object storage (RustFS / MinIO / AWS), via aws-sdk-go-v2
S3_URL=localhost:9000
S3_BUCKET=docs
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
