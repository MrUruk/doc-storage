# Copy to .env and adjust. Loaded into the process environment (e.g. via
# `set -a; . ./.env; set +a` or docker-compose `env_file`).

# --- Postgres ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docstorage
# "simple" handles mixed RU/EN text without stemming assumptions.
DB_TEXT_SEARCH_CONFIG=simple

# --- S3 / object storage ---
S3_BUCKET=doc-storage
AWS_REGION=us-east-1
# For local MinIO. Leave UNSET in production to use real AWS S3.
S3_ENDPOINT_URL=http://localhost:9000
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# --- Anthropic agent ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_EFFORT=high
DEFAULT_DOC_TYPE=deploy_order

# --- Server ---
HOST=0.0.0.0
PORT=8080
